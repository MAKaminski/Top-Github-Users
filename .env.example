# Copy to .env.local for development. Every variable here is optional — the site
# builds and runs with none of them set, which is what a fresh clone should do.

# Canonical origin. Drives canonical URLs, the sitemap, robots.txt, Open Graph
# image URLs and every JSON-LD @id. Leave unset and it falls back to the Vercel
# production hostname, then to the deployed default. Set this the moment a real
# domain points at the deployment — it is the only change needed.
# NEXT_PUBLIC_SITE_URL=https://commitgraph.example

# PostHog. Absent key means no analytics script, no cookie and no consent
# banner, so forks and previews make zero third-party requests. The key is a
# write-only ingest token and is meant to ship in the client bundle; it is not
# a secret.
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Crawler only, and never needed to run the site — the application makes no
# GitHub calls at all. A classic PAT with NO scopes is enough, since everything
# the crawler reads is public. In CI this lives in the GH_CRAWL_TOKEN repository
# secret, not here.
# GH_CRAWL_TOKEN=ghp_...
